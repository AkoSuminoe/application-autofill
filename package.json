{
  "name": "application-autofill",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Chrome extension that fills job application forms from a local answer bank.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:mv3": "npm run build",
    "test:mv3": "node tests/mv3.smoke.mjs",
    "premedia": "npm run build",
    "media": "node scripts/capture-media.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
